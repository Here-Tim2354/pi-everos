{
  "name": "pi-everos",
  "version": "0.1.0",
  "description": "EverOS long-term memory for the pi coding agent: session recall, incremental commit, and two model-callable tools.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Here-Tim2354/pi-everos.git"
  },
  "bugs": {
    "url": "https://github.com/Here-Tim2354/pi-everos/issues"
  },
  "homepage": "https://github.com/Here-Tim2354/pi-everos#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "memory",
    "everos"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "src",
    "skills",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "verify": "npm run typecheck && npm test",
    "check": "biome check .",
    "format": "biome check --write ."
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typebox": "^1.3.28",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
